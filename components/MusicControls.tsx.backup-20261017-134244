    justifyContent: 'center',
  },
  artworkIcon: {
    color: COLORS.blue,
    fontSize: 29,
    fontWeight: '700',
  },
  songDetails: {
    flex: 1,
  },
  songTitle: {
    color: COLORS.white,
    fontSize: 16,
